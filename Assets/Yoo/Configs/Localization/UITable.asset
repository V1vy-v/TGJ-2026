--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfe684761a9a831408ee1e0e400ac34c, type: 3}
  m_Name: UITable
  m_EditorClassIdentifier: Assembly-CSharp::Framework.Services.Localization.LocalizationTable
  localizationGroups:
  - key: ui.pressAnyKey
    textEn: Press any key to continue.
    textCh: "\u6309\u4EFB\u610F\u952E\u7EE7\u7EED"
  - key: ui.pressAnyKeyExit
    textEn: Press any key to exit
    textCh: "\u6309\u4EFB\u610F\u952E\u9000\u51FA"
  - key: about.part1
    textEn: '      You are a mole living underground, tired of the same quiet days.
      One day, an unfamiliar melody drifts into your cave, inspiring you to discover
      the world outside. In melo melo, follow the sound through dark tunnels, lush
      forests, and babbling streams. Use sound waves to find your way, distribute
      energy with your keyboard, and adjust platforms and speakers to carry the sound
      onward. Explore, make friends, and discover both the source of the melody and
      your own way to express yourself.'
    textCh: "      \u4F60\u662F\u4E00\u53EA\u751F\u6D3B\u5728\u5730\u4E0B\u7684\u9F39\u9F20\uFF0C\u65E9\u5DF2\u538C\u5026\u4E86\u65E5\u590D\u4E00\u65E5\u7684\u5B89\u9759\u3002\u76F4\u5230\u67D0\u5929\uFF0C\u4E00\u6BB5\u964C\u751F\u7684\u65CB\u5F8B\u4F20\u8FDB\u6D1E\u7A74\uFF0C\u8BA9\u4F60\u7B2C\u4E00\u6B21\u60F3\u53BB\u770B\u770B\u5916\u9762\u7684\u4E16\u754C\u3002\u5728\u300Amelo
      melo\u300B\u4E2D\uFF0C\u4F60\u5C06\u5FAA\u7740\u58F0\u97F3\u7A7F\u8FC7\u5E7D\u6697\u7684\u96A7\u9053\u3001\u8471\u90C1\u7684\u68EE\u6797\u4E0E\u6F7A\u6F7A\u7684\u6EAA\u6D41\uFF0C\u501F\u52A9\u58F0\u6CE2\u5BFB\u627E\u9053\u8DEF\uFF0C\u7528\u624B\u4E2D\u7684\u952E\u76D8\u5206\u914D\u80FD\u91CF\uFF0C\u8C03\u6574\u5E73\u53F0\u4E0E\u5587\u53ED\uFF0C\u8BA9\u4E2D\u65AD\u7684\u58F0\u97F3\u7EE7\u7EED\u4F20\u5411\u8FDC\u65B9\u3002\u4E00\u8DEF\u63A2\u7D22\u3001\u7ED3\u8BC6\u4F19\u4F34\uFF0C\u5BFB\u627E\u65CB\u5F8B\u7684\u6E90\u5934\uFF0C\u4E5F\u5BFB\u627E\u5C5E\u4E8E\u81EA\u5DF1\u7684\u8868\u8FBE\u3002"
  - key: about.part2
    textEn: May listening to the world give you the courage to play your own tune.
    textCh: "\u613F\u4F60\u5728\u542C\u89C1\u4E16\u754C\u4E4B\u540E\uFF0C\u4E5F\u6709\u52C7\u6C14\u594F\u51FA\u81EA\u5DF1\u7684\u4E50\u7AE0\u3002"
  - key: about.part3
    textEn: "Credits:\nGame Design: xixizi6, \u8336\u96FE   Programming: V1vy-v\nArt:
      bird19, Luvi            Writing: \u8336\u96FE"
    textCh: "\u5236\u4F5C\u56E2\u961F\uFF1A\n\u7B56\u5212\uFF1Axixizi6 \u8336\u96FE 
      \u7A0B\u5E8F\uFF1AV1vy-v  \u7F8E\u672F\uFF1Abird19  Luvi  \u6587\u6848\uFF1A\u8336\u96FE"
