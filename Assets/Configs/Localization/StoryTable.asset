--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfe684761a9a831408ee1e0e400ac34c, type: 3}
  m_Name: StoryTable
  m_EditorClassIdentifier: Assembly-CSharp::Framework.Services.Localization.LocalizationTable
  localizationGroups:
  - key: speaker.narrator
    textEn: Narrator
    textCh: "\u65C1\u767D"
  - key: story.intro.1
    textEn: You are a mole living underground; the dull, quiet subterranean life
      fills you with pain.
    textCh: "\u4F60\u662F\u4E00\u53EA\u751F\u6D3B\u5728\u5730\u91CC\u7684\u9F39\u9F20\uFF0C\u67AF\u71E5\u5B89\u9759\u7684\u5730\u4E0B\u751F\u6D3B\u8BA9\u4F60\u5341\u5206\u75DB\u82E6\u3002"
  - key: story.intro.2
    textEn: On an ordinary day, you hear a sound unlike any other.
    textCh: "\u5BFB\u5E38\u7684\u4E00\u5929\uFF0C\u4F60\u5374\u542C\u5230\u4E86\u4E0D\u4E00\u6837\u7684\u58F0\u97F3\u3002"
  - key: story.intro.3
    textEn: Go find out where the sound is coming from.
    textCh: "\u53BB\u627E\u627E\u58F0\u97F3\u662F\u4ECE\u54EA\u91CC\u53D1\u51FA\u6765\u7684\u5427\u3002"
  - key: story.firstEnd.1
    textEn: There seems to be the sound of water ahead. What could it be?
    textCh: "\u524D\u9762\u597D\u50CF\u6709\u6C34\u58F0\uFF0C\u662F\u4EC0\u4E48\u5462\uFF1F"
  - key: story.secondIntro.1
    textEn: The sound is still ringing. Where on earth is it coming from?
    textCh: "\u58F0\u97F3\u8FD8\u5728\u54CD\uFF0C\u5230\u5E95\u662F\u54EA\u91CC\u53D1\u51FA\u6765\u7684\u5462\uFF1F"
  - key: story.ending.1
    textEn: Everyone else's performance has ended. What about yours?
    textCh: "\u522B\u4EBA\u7684\u6F14\u51FA\u7ED3\u675F\u4E86\uFF0C\u4F60\u5462\uFF1F"
  - key: story.ending.2
    textEn: "Don't worry \u2014 everyone gets a chance to play their own melody."
    textCh: "\u522B\u62C5\u5FC3\uFF0C\u6BCF\u4E2A\u4EBA\u90FD\u6709\u673A\u4F1A\u594F\u51FA\u81EA\u5DF1\u7684\u4E50\u7AE0\u3002"
  - key: story.ending.3
    textEn: Pick up the keyboard and tell your story...
    textCh: "\u62FF\u8D77\u952E\u76D8\uFF0C\u8BB2\u8BB2\u4F60\u7684\u6545\u4E8B\u5427......"
